# Any OpenAI-compatible service works. These values are for OpenRouter.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=your-key-here
# Pick any chat model from https://openrouter.ai/models
LLM_MODEL=meta-llama/llama-3.1-8b-instruct
# Optional. Lower is more predictable, higher is more varied. Blank or unset means 0.3.
LLM_TEMPERATURE=0.3
# The model that turns text into vectors for retrieval. It uses the same base URL and key.
EMBED_MODEL=openai/text-embedding-3-small
# Safety mode for Part 5. "on" applies the simple guardrails, "off" behaves like Part 4.
# Blank or unset means on.
GUARDRAILS=on
